    "events": ["AfterAgent", "Notification", "SessionStart", "SessionEnd", "BeforeAgent"],
    "configPath": "settings.json",
    "configFormat": "nested",
    "normalize": { "AfterAgent": "Stop", "BeforeAgent": "UserPromptSubmit" }
  },
  "icon": {
