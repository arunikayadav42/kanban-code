{
  "id": "gemini",
  "displayName": "Gemini CLI",
  "shortName": "Gemini",
  "cliCommand": "gemini",
  "availabilityCheck": "gemini",
  "promptCharacter": "Type your message",
  "autoApproveFlag": "--yolo",
  "resumeFlag": "--resume",
  "configDirName": ".gemini",
  "historySymbol": "\u2726",
